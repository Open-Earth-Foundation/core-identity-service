# Copy to .env and fill in the blank values. For local development any values
# work: docker-compose.yml creates the identity database with them.

# Identity database (this service owns it).
DATABASE_HOST="localhost"
DATABASE_PORT=5440
DATABASE_NAME=""
DATABASE_USER=""
DATABASE_PASSWORD=""
DATABASE_USE_SSL=false

# CityCatalyst database. Only used by `npm run db:copy-from-citycatalyst`,
# which reads from it and never writes to it.
CITYCATALYST_DATABASE_HOST="localhost"
CITYCATALYST_DATABASE_PORT=5432
CITYCATALYST_DATABASE_NAME=""
CITYCATALYST_DATABASE_USER=""
CITYCATALYST_DATABASE_PASSWORD=""
CITYCATALYST_DATABASE_USE_SSL=false

# Public origin used in verification and reset email links (no trailing slash).
PUBLIC_ORIGIN="http://localhost:3000"

# 32-byte key (base64) that seals TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_ENCRYPTION_KEY=""

# CSRF HMAC secret for browser forms. Any long random string.
CSRF_SECRET=""

# Optional. Shown in authenticator apps.
# TOTP_ISSUER="CityCatalyst Identity"

# Optional SMTP. When unset, mail is logged to an in-memory sink (and printed).
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="identity@example.com"

# OAuth / OpenID Connect provider (CC-1280).
# RSA private key (PEM, 2048 bits or more) that signs access tokens and
# id_tokens. Line breaks may be written as \n. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
OAUTH_SIGNING_KEY=""

# Optional. The `iss` of tokens and the `issuer` in discovery. Default: PUBLIC_ORIGIN.
# OAUTH_ISSUER="http://localhost:3000"

# Optional. The `aud` of access tokens (the API they are for). Default: PUBLIC_ORIGIN.
# OAUTH_AUDIENCE="http://localhost:3000"

# Resource servers allowed to call /oauth/introspect/, as comma separated
# id:secret pairs (HTTP Basic). With none set, nobody may introspect.
# OAUTH_RESOURCE_SERVERS="citycatalyst-api:change-me"

# Platform admins for /api/admin/clients/. Comma separated verified emails, or
# domain suffixes that start with @ (for example @example.org).
# IDENTITY_ADMIN_EMAILS="admin@example.org"
